 #include <zephyr/dt-bindings/gpio/gpio.h>
 #include <zephyr/dt-bindings/i2c/i2c.h>

&usart1 {
    status = "disabled";
};

&i2c1 {
    pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
    pinctrl-1 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
    pinctrl-names = "default", "sleep";

    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    cs35l45_l: cs35l45@32 {
        compatible = "cirrus,cs35l45";
        reg = <0x32>;
        status = "okay";

        reset-gpios = <&gpioc 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		int-gpios = <&gpioa 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    cs35l45_r: cs35l45@33 {
        compatible = "cirrus,cs35l45";
        reg = <0x33>;
        status = "okay";

		int-gpios = <&gpioa 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
